        $message = \"Error: \" . $e->getMessage();\n        $msg_type = \"danger\";\n    }\n}\n\n$companies = [];\nif ($batch) {\n    $stmt = $pdo->prepare(\"SELECT * FROM companies WHERE import_batch_id = ? ORDER BY id\");\n    $stmt->execute([$batch]);\n    $companies = $stmt->fetchAll();\n}\n\n// --- Fetch Dictionary Data ---\n$provinces = $pdo->query(\"SELECT pro_id, pro_name FROM province ORDER BY pro_name\")->fetchAll();\n$all_districts = $pdo->query(\"SELECT pro_id, dis_name FROM district ORDER BY dis_name\")->fetchAll();\n$sectors = $pdo->query(\"SELECT sector_name FROM business_sectors WHERE active = 1 ORDER BY sector_name\")->fetchAll();\n\nrequire_once __DIR__ . \"/../includes/header.php\";\n?>\n<div class=\"row mb-3\">\n  <div class=\"col-12 d-flex justify-content-between align-items-center\">\n    <div>\n      <h2><a href=\"import_cit.php\" class=\"text-dark text-decoration-none\"><i class=\"fas fa-arrow-left me-2\"></i></a> Company Data</h2>\n      <p class=\"text-muted\">Batch: <code><?= htmlspecialchars($batch ?: 'Manual Entry') ?></code> — <strong><?= count($companies) ?></strong> companies</p>\n    </div>\n    <div class=\"btn-group shadow-sm\">\n      <button class=\"btn btn-primary\" onclick=\"addCompany()\"><i class=\"fas fa-plus me-2\"></i> Add Record</button>\n      <a href=\"calculator.php?batch=<?= urlencode($batch) ?>\" class=\"btn btn-success\"><i class=\"fas fa-calculator me-2\"></i> Run TE Calculation</a>\n    </div>\n  </div>\n</div>\n\n<?php if ($message): ?>\n<div class=\"alert alert-<?= $msg_type ?> alert-dismissible fade show shadow-sm\">\n    <?= $message ?>\n    <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"alert\"></button>\n</div>\n<?php endif; ?>\n\n<div class=\"card border-0 shadow-sm\" style=\"border-radius:12px\">\n  <div class=\"card-body\">\n    <table class=\"table table-bordered table-hover datatable w-100\" style=\"font-size:0.85em\">\n      <thead class=\"table-light text-uppercase small\">\n        <tr