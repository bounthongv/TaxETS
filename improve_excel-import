.value = c.total_assets;\n    document.getElementById('edit_registration_date').value = c.registration_date;\n    document.getElementById('edit_investment_license_date').value = c.investment_license_date;\n\n    // Checkboxes\n    const cbs = [\"zone_1\", \"zone_2\", \"zone_3\", \"is_vat_holder\", \"flag_sez_developer\", \"flag_sez_investor\", \"flag_act_production_services\", \"flag_public_benefit\", \"flag_act_1_4_7_8_9\", \"flag_act_2_3_5_6\"];\n    cbs.forEach(cb => {\n        document.getElementById('edit_' + cb).checked = (c[cb] == 1);\n    });\n\n    new bootstrap.Modal(document.getElementById('editModal')).show();\n}\n</script>\n<?php require_once __DIR__ . \"/../includes/footer.php\"; ?>\n",
