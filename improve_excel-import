ss=\"btn btn-secondary\" data-bs-dismiss=\"modal\">Cancel</button>\n          <button type=\"submit\" class=\"btn btn-primary\"><i class=\"fas fa-save me-1\"></i> Save Changes</button>\n        </div>\n      </form>\n    </div>\n  </div>\n</div>\n\n<script>\nconst allDistricts = <?= json_encode($all_districts) ?>;\n\n// Attach event listeners to edit buttons\ndocument.addEventListener('DOMContentLoaded', function() {\n    document.querySelectorAll('.edit-btn').forEach(btn => {\n        btn.addEventListener('click', function() {\n            try {\n                const data = JSON.parse(this.getAttribute('data-company'));\n                editCompany(data);\n            } catch(e) {\n                console.error(\"Error parsing company data\", e);\n            }\n        });\n    });\n});\n\nfunction addCompany() {\n    document.getElementById('modalAction').value = 'add_company';\n    document.getElementById('modalTitle').innerHTML = '<i class=\"fas fa-plus me-2\"></i> Add New Company Record';\n    document.getElementById('edit_id').value = '';\n    \n    // Clear all inputs\n    const form = document.querySelector('#editModal form');\n    form.reset();\n    \n    // Reset district dropdown\n    document.getElementById('edit_district').innerHTML = '<option value=\"\">-- Select District --</option>';\n    \n    new bootstrap.Modal(document.getElementById('editModal')).show();\n}\n\nfunction filterDistricts(selectedDistrictName = \"\") {\n    const provinceSelect = document.getElementById('edit_province');\n    const districtSelect = document.getElementById('edit_district');\n    const selectedOption = provinceSelect.options[provinceSelect.selectedIndex];\n    \n    let provinceId = null;\n    if (selectedOption && selectedOption.value) {\n        provinceId = selectedOption.getAttribute('data-id');\n    }\n\n    districtSelect.innerHTML = '<option value=\"\">-- Select District --</option>';\n    \n    if (provinceId) {\n        const filtered = allDistricts.filter(d => d.pro_id === provinceId);\n        filtered.forEach(d => {\n            const opt = document.createElement('option');\n            opt.value = d.dis_name;\n            opt.textContent = d.dis_name;\n            if (d.dis_name === selectedDistrictName) opt.selected = true;\n            districtSelect.appendChild(opt);\n        });\n    }\n}\n\nfunction editCompany(c) {\n    document.getElementById('modalAction').value = 'update_company';\n    document.getElementById('modalTitle').innerHTML = '<i class=\"fas fa-edit me-2\"></i> Edit Company Record';\n    document.getElementById('edit_id').value = c.id;\n    document.getElementById('edit_tax_year').value = c.tax_year;\n    document.getElementById('edit_tin').value = c.tin;\n    document.getElementById('edit_company_name').value = c.company_name;\n    \n    // Set Province and trigger District filter\n    document.getElementById('edit_province').value = c.province;\n    filterDistricts(c.district);\n    \n    document.getElementById('edit_sector').value = c.sector;\n    document.getElementById('edit_revenue').value = c.revenue;\n    document.getElementById('edit_expense').value = c.expense;\n    document.getElementById('edit_net_profit').value = c.net_profit;\n    document.getElementById('edit_pt_paid').value = c.pt_paid;\n    document.getElementById('edit_staff_count').value = c.staff_count;\n    document.getElementById('edit_total_assets').value = c.total_assets;\n    document.getElementById('edit_registration_date').value = c.registration_date;\n    document.getElementById('edit_investment_license_date').value = c.investment_license_date;\n\n    // Checkboxes\n    const cbs = [\"zone_1\", \"zone_2\", \"zone_3\", \"is_vat_holder\", \"flag_sez_developer\", \"flag_sez_investor\", \"flag_act_production_services\", \"flag_public_benefit\", \"flag_act_1_4_7_8_9\", \"flag_act_2_3_5_6\"];\n    cbs.forEach(cb => {\n        const el = document.getElementById('edit_' + cb);\n        if (el) el.checked = (c[cb] == 1);\n    });\n\n    new bootstrap.Modal(document.getElementById('editModal')).show();\n}\n</script>\n<?php require_once __DIR__ . \"/../includes/footer.php\"; ?>\n",
