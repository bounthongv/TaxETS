# =====================================================================
# Tax-ETS — Local .env (Option B: Docker MySQL via bundled MariaDB)
# ---------------------------------------------------------------------
# This file is read by docker-compose.yml. It tells the web service to
# connect to the bundled MySQL container (service name `db`) instead of
# an external MySQL like XAMPP.
#
# To use: cp .env.docker .env  then  docker compose --profile with-db up -d
# To switch back to XAMPP: cp .env.xampp .env  then  docker compose up -d
#
# The MYSQL_ROOT_PASSWORD below is only used by the MySQL container
# (service `db`). The web container authenticates as `tax_ets_user`.
# =====================================================================

# ---- Application DB connection (Docker MySQL) ----
DB_HOST=db
DB_PORT=3306
DB_NAME=tax_ets
DB_USER=tax_ets_user
DB_PASS=tax_ets_dev_pass

# ---- Docker MySQL root (only used by the `db` service) ----
MYSQL_ROOT_PASSWORD=tax_ets_root_pass

# ---- Application ----
BASE_URL=
TZ=Asia/Vientiane
