class JobTracker {
    constructor() {
        this.currentLang = document.documentElement.lang || 'en';
        this.initJobTracking();
    }

    initJobTracking() {
        const activeJobs = this.getActiveJobs();
        
        // Kiểm tra từng job trong localStorage
        Object.entries(activeJobs).forEach(([statusId, jobInfo]) => {
            if (jobInfo && jobInfo.reportName) { // Chỉ xử lý các job hợp lệ
                this.checkJobStatus(statusId);
            }
        });
    }

    addJob(statusId, reportName) {
        const activeJobs = this.getActiveJobs();
        activeJobs[statusId] = {
            reportName: reportName,
            startTime: new Date().toISOString()
        };
        this.saveActiveJobs(activeJobs);
        this.checkJobStatus(statusId);
    }

    checkJobStatus(statusId) {
        axios.get(`/report/check-status/${statusId}`)
            .then(response => {
                if (response.data.success) {
                    const status = response.data.status;
                    
                    if (status === 2) { // Completed
                        this.showJobNotification(statusId, 'success');
                        this.removeJob(statusId);
                    
                    } else if (status === 3) { // Failed
                        this.showJobNotification(statusId, 'error', response.data.error_message);
                        this.removeJob(statusId);
                    } else if (status === 1) { // Still processing
                        setTimeout(() => this.checkJobStatus(statusId), 5000); // Check again after 5 seconds
                    }
                }
            })
            .catch(error => {
                console.error('Error checking job status:', error);
            });
    }

    showJobNotification(statusId, type, errorMessage = '') {
        const jobInfo = this.getActiveJobs()[statusId];
        if (!jobInfo || !jobInfo.reportName) return;

        const title = this.currentLang === 'en' 
            ? (type === 'success' ? 'Success' : 'Error')
            : (type === 'success' ? 'ສຳເລັດ' : 'ຂໍ້ຜິດພາດ');
        
        const text = this.currentLang === 'en'
            ? (type === 'success' 
                ? `Data update for ${jobInfo.reportName} has been completed successfully.`
                : `Failed to update data for ${jobInfo.reportName}: ${errorMessage}`)
            : (type === 'success'
                ? `ການອັບເດດຂໍ້ມູນສຳລັບ ${jobInfo.reportName} ສຳເລັດແລ້ວ.`
                : `ບໍ່ສາມາດອັບເດດຂໍ້ມູນສຳລັບ ${jobInfo.reportName}: ${errorMessage}`);

        Swal.fire({
            title: title,
            text: text,
            icon: type === 'success' ? 'success' : 'error',
            confirmButtonText: this.currentLang === 'en' ? 'OK' : 'ຕົກລົງ'
        }).then(() => {
            if (window.location.pathname.includes('/report/')) {
                window.location.reload();
            }
        });
    }

    getActiveJobs() {
        try {
            const jobs = localStorage.getItem('activeJobs');
            const parsedJobs = jobs ? JSON.parse(jobs) : {};
            
            // Kiểm tra và chuyển đổi nếu dữ liệu là mảng
            if (Array.isArray(parsedJobs)) {
                const newJobs = {};
                parsedJobs.forEach((job, index) => {
                    if (job && job.reportName) {
                        newJobs[index] = job;
                    }
                });
                this.saveActiveJobs(newJobs);
                return newJobs;
            }
            
            return parsedJobs;
        } catch (error) {
            console.error('Error parsing activeJobs:', error);
            return {};
        }
    }

    saveActiveJobs(jobs) {
        try {
            localStorage.setItem('activeJobs', JSON.stringify(jobs));
        } catch (error) {
            console.error('Error saving activeJobs:', error);
        }
    }

    removeJob(statusId) {
        const activeJobs = this.getActiveJobs();
        delete activeJobs[statusId];
        this.saveActiveJobs(activeJobs);
    }
}

// Tạo instance toàn cục
window.jobTracker = new JobTracker(); 