# =====================================================================
# Tax-ETS — Environment variables template
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# Then edit `.env` with your real database credentials.
# `.env` is in .gitignore so it will NEVER be committed to git.
# =====================================================================

# ---- Database connection ----
# These are read by `config.php` (we read them via getenv() in PHP).
# For the local dev container, the defaults below match
# docker-compose.yml — usually you don't need to change them.
DB_HOST=db
DB_PORT=3306
DB_NAME=tax_ets
DB_USER=tax_ets_user
DB_PASS=change_this_password

# ---- Root MySQL password (only used once at first container startup) ----
# This sets the password for the MySQL `root` user, separate from
# the application user above. Pick a strong one and DON'T reuse
# the application password.
MYSQL_ROOT_PASSWORD=change_this_root_password_too

# ---- Application ----
# BASE_URL is the public URL the app is served at, with NO trailing slash.
# Examples:
#   - Local dev (http://localhost:8080):  BASE_URL=
#   - Subdirectory (http://example.com/tax-ets):  BASE_URL=/tax-ets
# Leave empty for auto-detection (works for most cases).
BASE_URL=

# ---- Timezone ----
TZ=Asia/Vientiane
