# =====================================================================
# Tax-ETS — Local .env (Option A: XAMPP MySQL via host.docker.internal)
# ---------------------------------------------------------------------
# This file is read by docker-compose.yml. It overrides the defaults
# baked into the compose file.
#
# When the PHP container runs, host.docker.internal resolves to the
# Windows host's IP (192.168.100.52), so the container can reach
# XAMPP's MySQL even though its not on the containers network.
#
# MYSQL_ROOT_PASSWORD is intentionally NOT set here - it is only used
# by the optional bundled MySQL service (--profile with-db), and the
# docker-compose.yml default will apply if you ever enable that.
# =====================================================================

# ---- Application DB connection (XAMPP MySQL on Windows host) ----
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=tax_ets
DB_USER=root
DB_PASS=

# ---- Application ----
BASE_URL=
TZ=Asia/Vientiane
